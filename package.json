{
  "name": "c3",
  "version": "0.1.0",
  "private": true,
  "description": "C3 desktop UI foundation",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:test": "C3_TEST_MODE=1 VITE_C3_TEST_MODE=1 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "preview:test": "C3_TEST_MODE=1 VITE_C3_TEST_MODE=1 electron-vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:smoke": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.c3.desktop",
    "productName": "C3",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "dist/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
